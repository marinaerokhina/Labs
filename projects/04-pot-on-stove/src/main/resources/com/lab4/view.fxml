<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import com.lab4.presentation.TemperatureChart?>

<VBox fx:id="rootPane" alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lab4.presentation.MainController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   
   <!-- Заголовок -->
   <Label text="Кастрюля на плите" textFill="#2c3e50">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
   </Label>
   
   <!-- Температура -->
   <VBox alignment="CENTER" spacing="5.0">
      <Label text="Температура:" textFill="#34495e">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="temperatureLabel" text="20.0 °C" textFill="#e74c3c">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
   </VBox>
   
   <!-- Объем -->
   <VBox alignment="CENTER" spacing="5.0">
      <Label text="Объем:" textFill="#34495e">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="volumeLabel" text="1.0 л" textFill="#3498db">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
   </VBox>
   
   <!-- Состояние крышки -->
   <Label fx:id="lidStatusLabel" text="Крышка: на месте" textFill="#34495e">
      <font>
         <Font size="14.0" />
      </font>
   </Label>
   
   <!-- Управление конфоркой -->
   <VBox alignment="CENTER" spacing="5.0">
      <Label text="Уровень конфорки:" textFill="#34495e">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" spacing="10.0">
         <Slider fx:id="burnerSlider" blockIncrement="1.0" majorTickUnit="1.0" max="4.0" min="0.0" showTickLabels="true" showTickMarks="true" value="0.0" prefWidth="300.0" snapToTicks="true" />
         <Label fx:id="burnerValueLabel" text="0" textFill="#34495e">
            <font>
               <Font size="16.0" style="BOLD" />
            </font>
         </Label>
      </HBox>
   </VBox>
   
   <!-- Доливание воды -->
   <VBox alignment="CENTER" spacing="5.0">
      <Label text="Долить воду:" textFill="#34495e">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" spacing="5.0">
         <Label text="Объем (л):" />
         <TextField fx:id="waterVolumeField" prefWidth="80.0" promptText="0.5" />
         <Label text="Температура (°C):" />
         <TextField fx:id="waterTemperatureField" prefWidth="80.0" promptText="20" />
         <Button fx:id="addWaterButton" mnemonicParsing="false" onAction="#onAddWaterClicked" text="Долить" />
      </HBox>
   </VBox>
   
   <!-- Кнопка переключения крышки -->
   <Button fx:id="lidToggleButton" mnemonicParsing="false" onAction="#onLidToggleClicked" prefHeight="40.0" prefWidth="200.0" text="Снять крышку" />
   
   <!-- Кнопка открытия графика -->
   <Button mnemonicParsing="false" onAction="#onShowChartClicked" prefHeight="40.0" prefWidth="200.0" text="Показать график температуры" />
   
   <!-- Статусная строка -->
   <Label fx:id="statusLabel" text="" textFill="#27ae60">
      <font>
         <Font size="12.0" />
      </font>
   </Label>
</VBox>

